# ==============================================================================
# APP CONFIGURATION (default.env)
# ==============================================================================
# This file contains DEFAULT values for the application.
# To override these, create a local 'configs/.env' file.
# ==============================================================================

# --- ENVIRONMENT ---
# Options: development, production
env=development

# --- SERVER ---
server_port=8080

# --- LOGGING ---
log_level=debug
log_output=./logs/server.log
log_max_size=100
log_max_backups=5
log_max_age=7
log_compress=true

# --- DATABASE ---
db_host=localhost
db_port=5432
db_user=postgres
db_password=postgres
db_name=hris
db_ssl_mode=disable

# --- SECURITY (JWT) ---
# IMPORTANT: Always override 'jwt_secret' in your local 'configs/.env' file!
jwt_secret=your-secret-key-here
jwt_expire_minutes=60
jwt_refresh_expire_minutes=1440

# --- IDEMPOTENCY ---
idempotency_expire_minutes=60

# --- REDIS ---
# Set use_miniredis=true to use embedded redis (no external dependency)
use_miniredis=true
redis_addr=localhost:6379
redis_password=
redis_db=0

# --- PROFILER ---
profiler_token=profiler-token

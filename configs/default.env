# ==============================================================================
# APP CONFIGURATION (default.env)
# ==============================================================================
# This file contains DEFAULT values for the application.
# To override these, create a local 'configs/.env' file.
# ==============================================================================

# --- SERVICE ---
env=development # options: development, production
port=8080
idempotency_expire_minutes=60
profiler_token=profiler-token

# --- LOGGING ---
log_level=debug
log_file_path=./logs/server.log
log_max_size=100
log_max_backups=5
log_max_age=7
log_compress=true

# --- DATABASE ---
db_host=localhost
db_port=5432
db_user=postgres
db_password=postgres
db_name=hris
db_ssl_mode=disable

# --- AUTH ---
jwt_secret=your-secret-key-here
jwt_expire_minutes=60
jwt_refresh_expire_minutes=1440

# --- CACHE ---
redis_addr=localhost:6379
redis_password=
redis_db=0

use_miniredis=true # use embedded redis (no external dependency)
